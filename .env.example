# Copie para .env e ajuste os caminhos ABSOLUTOS no novo PC.
# .env e credenciais nao devem ser adicionados ao Git.
PYTHONIOENCODING=utf-8

# Drive: ID de pasta nao e uma chave de autenticacao.
HSL_DRIVE_FOLDER_ID=1j2tFJVmQrXOLE_aEvlDG1Yo1zQUx-sTq
HSL_GOOGLE_CLIENT_SECRET_FILE="C:/HSL-SECRETS/google-client-secret.json"
HSL_GOOGLE_TOKEN_FILE="C:/HSL-SECRETS/google-token.json"
HSL_PYTHON="C:/HSL/hsl-video-studio/.venv/Scripts/python.exe"
# Opcional: concorrencia de upload (1 a 4).
HSL_DRIVE_WORKERS=4

# Agente Firefly externo: codigo + main.py + .venv/Scripts/python.exe.
# Esse Python e independente de HSL_PYTHON.
HSL_FIREFLY_AGENT_DIR="C:/HSL/firefly-agent"
HSL_FIREFLY_CHROME_PROFILE="C:/HSL-FIREFLY-PROFILE"
# A CLI pede autorizacao para Kling. Nao habilite despacho pago no .env.

# Preferir o menu [E] do Matrix para cadastrar as chaves ElevenLabs.
# Se usar env em vez do cofre, preencha SOMENTE no .env local.
ELEVENLABS_API_KEY=
ELEVENLABS_BACKUP_KEY_1=
ELEVENLABS_BACKUP_KEY_2=
ELEVENLABS_BACKUP_KEY_3=
HSL_ELEVENLABS_VOICE_ID=iP95p4xoKVk53GoZ742B
HSL_ELEVENLABS_VOICE_NAME=Chris
HSL_ELEVENLABS_MODEL=eleven_multilingual_v2
HSL_ELEVENLABS_STABILITY=0.45
HSL_ELEVENLABS_SIMILARITY_BOOST=0.80
HSL_ELEVENLABS_STYLE=0.25

# Codex e Antigravity usam sessoes das CLIs, nao chaves neste arquivo.
