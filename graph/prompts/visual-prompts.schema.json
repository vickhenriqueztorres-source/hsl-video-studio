{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["beats"],
  "properties": { "beats": { "type": "array", "minItems": 1, "items": {
    "type": "object", "additionalProperties": false,
    "required": ["beatId", "imagePrompt", "videoPrompt", "cameraMotion", "durationSeconds", "firstFrameFrom"],
    "properties": {
      "beatId": {"type":"string","minLength":1}, "imagePrompt":{"type":"string","minLength":20},
      "videoPrompt":{"type":"string","minLength":20}, "cameraMotion":{"type":"string","minLength":2},
      "durationSeconds":{"type":"number","exclusiveMinimum":0}, "firstFrameFrom":{"enum":["image","none"]},
      "negative":{"type":"string"}, "continuityRefs":{"type":"array","items":{"type":"string"}}
    }
  }}}
}
