{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "themes"
  ],
  "properties": {
    "themes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "theme",
          "title",
          "entity",
          "mechanism",
          "constraint",
          "consequence",
          "thesis"
        ],
        "properties": {
          "theme": {
            "type": "string",
            "description": "Portuguese summary hook or title description"
          },
          "title": {
            "type": "string",
            "description": "High-CTR documentary title in canonical channel language"
          },
          "entity": {
            "type": "string",
            "description": "Concrete physical system, infrastructure or criminal technique"
          },
          "mechanism": {
            "type": "string",
            "description": "Specific mechanical or technical causality explaining how the system works"
          },
          "constraint": {
            "type": "string",
            "description": "Physical, chronological or operational bottleneck/limit"
          },
          "consequence": {
            "type": "string",
            "description": "Catastrophic failure mode or cascade impact"
          },
          "thesis": {
            "type": "string",
            "description": "Core analytical thesis explaining the counter-intuitive truth"
          }
        }
      }
    }
  }
}
